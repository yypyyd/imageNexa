# Copy this file to .env before starting the stack. Never commit the real .env.
APP_ENV=production
APP_TITLE=2API
PUBLIC_BASE_URL=https://api.example.com
CORS_ORIGINS=https://api.example.com
COOKIE_SECURE=true
SESSION_COOKIE_NAME=twoapi_admin_session
# Required once, when creating the only administrator. Generate a long random
# value and remove it from operator notes after initialization (keep the runtime
# environment value present so production restarts remain fail-closed).
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-token
# Trust only reverse proxies you operate. Docker's private bridge plus loopback
# are sufficient for the bundled web container; add an outer proxy CIDR here.
TRUSTED_PROXY_CIDRS=172.16.0.0/12,127.0.0.0/8,::1/128

POSTGRES_DB=vivid_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password

RUSTFS_BUCKET=twoapi
RUSTFS_ACCESS_KEY=replace-with-a-random-access-key
RUSTFS_SECRET_KEY=replace-with-a-long-random-secret
