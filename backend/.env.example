# Standalone backend development template. The supported production deployment
# uses ../.env.example with ../docker-compose.yml instead.
APP_ENV=development
APP_TITLE=2API
HTTP_ADDR=:6666
PUBLIC_BASE_URL=http://127.0.0.1:6666

# PostgreSQL schema is installed by forward-only migrations at startup.
POSTGRES_DSN=host=127.0.0.1 user=postgres password=postgres dbname=vivid_ai port=5432 sslmode=disable TimeZone=Asia/Shanghai

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
SESSION_COOKIE_NAME=twoapi_admin_session
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-token
# A directly run backend should trust only local development proxies.
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128

# Use the same private RustFS instance as the full stack when exercising media
# generation locally. These values are examples, not production credentials.
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_BUCKET=twoapi
RUSTFS_ACCESS_KEY=replace-with-a-random-access-key
RUSTFS_SECRET_KEY=replace-with-a-long-random-secret

# Optional; defaults to backend/data/generated.
# GENERATED_ROOT=E:/path/to/private/generated
